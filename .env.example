# ============================================
#  GABARIT DE CONFIGURATION — NE PAS COMMITER LE VRAI .env
# ============================================
#  Copiez ce fichier en `.env` et renseignez vos valeurs :
#      Windows (PowerShell) :  copy .env.example .env
#      Linux / macOS         :  cp .env.example .env
#
#  Le fichier `.env` est ignore par Git (cf. .gitignore).
#  Ne versionnez jamais vos vraies cles : uniquement ce gabarit.
# ============================================

# --- SECRET DJANGO (OBLIGATOIRE EN PRODUCTION) ---
# Generez une cle unique par installation, par exemple :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Ne reutilisez jamais la cle d'un autre environnement et ne la versionnez jamais.
DJANGO_SECRET_KEY = remplacez-par-une-cle-aleatoire-de-50-caracteres
DJANGO_DEBUG = False
DJANGO_ALLOWED_HOSTS = localhost,127.0.0.1

# --- RESEND (envoi d'emails) ---
# Cle API obtainue sur https://resend.com/api-keys
# Laissez vide pour desactiver l'envoi par email.
RESEND_API_KEY = 

# Expediteur. Pour un test rapide, Resend fournit
# onboarding@resend.dev (adresse limitee a votre compte).
# En production, utilisez une adresse d'un domaine verifie sur Resend.
RESEND_FROM_EMAIL = onboarding@resend.dev
RESEND_FROM_NAME = SHOPY

# Mettre a False pour desactiver l'envoi sans toucher au code.
RESEND_ENABLED = True
